openapi: 3.0.3
info:
	title: Swift Invoice API
	version: 1.0.0
	description: API REST para clientes, empresas, productos, ventas y facturas de Swift Invoice.
servers:
	- url: /swift_invoice/api
		description: Servidor local
tags:
	- name: Auth
	- name: Clients
	- name: Companies
	- name: Products
	- name: Sales
	- name: Invoices
	- name: Catalogs
paths:
	/auth/login:
		post:
			tags: [Auth]
			summary: Iniciar sesion
			requestBody:
				required: true
				content:
					application/json:
						schema:
							$ref: '#/components/schemas/LoginRequest'
			responses:
				'200':
					description: Sesion iniciada
					content:
						application/json:
							schema:
								$ref: '#/components/schemas/AuthResponse'
				'401':
					$ref: '#/components/responses/Unauthorized'

	/clients:
		get:
			tags: [Clients]
			summary: Listar clientes
			security: [{ sessionAuth: [] }]
			responses:
				'200':
					description: Clientes encontrados
					content:
						application/json:
							schema:
								type: array
								items:
									$ref: '#/components/schemas/Client'
		post:
			tags: [Clients]
			summary: Crear cliente
			security: [{ sessionAuth: [] }]
			requestBody:
				required: true
				content:
					application/json:
						schema:
							$ref: '#/components/schemas/ClientInput'
			responses:
				'201':
					description: Cliente creado
					content:
						application/json:
							schema:
								$ref: '#/components/schemas/Client'
				'422':
					$ref: '#/components/responses/ValidationError'
	/clients/{id}:
		parameters:
			- $ref: '#/components/parameters/Id'
		get:
			tags: [Clients]
			summary: Consultar cliente
			security: [{ sessionAuth: [] }]
			responses:
				'200':
					description: Cliente encontrado
					content:
						application/json:
							schema:
								$ref: '#/components/schemas/Client'
				'404':
					$ref: '#/components/responses/NotFound'
		put:
			tags: [Clients]
			summary: Actualizar cliente
			security: [{ sessionAuth: [] }]
			requestBody:
				required: true
				content:
					application/json:
						schema:
							$ref: '#/components/schemas/ClientInput'
			responses:
				'200':
					description: Cliente actualizado
					content:
						application/json:
							schema:
								$ref: '#/components/schemas/Client'
				'404':
					$ref: '#/components/responses/NotFound'
		delete:
			tags: [Clients]
			summary: Eliminar cliente
			security: [{ sessionAuth: [] }]
			responses:
				'204':
					description: Cliente eliminado
				'404':
					$ref: '#/components/responses/NotFound'

	/companies:
		get:
			tags: [Companies]
			summary: Listar empresas
			security: [{ sessionAuth: [] }]
			responses:
				'200':
					description: Empresas encontradas
					content:
						application/json:
							schema:
								type: array
								items:
									$ref: '#/components/schemas/Company'
		post:
			tags: [Companies]
			summary: Crear empresa
			security: [{ sessionAuth: [] }]
			requestBody:
				required: true
				content:
					application/json:
						schema:
							$ref: '#/components/schemas/CompanyInput'
			responses:
				'201':
					description: Empresa creada
					content:
						application/json:
							schema:
								$ref: '#/components/schemas/Company'
	/companies/{id}:
		parameters:
			- $ref: '#/components/parameters/Id'
		get:
			tags: [Companies]
			summary: Consultar empresa
			security: [{ sessionAuth: [] }]
			responses:
				'200':
					description: Empresa encontrada
					content:
						application/json:
							schema:
								$ref: '#/components/schemas/Company'
				'404':
					$ref: '#/components/responses/NotFound'
		put:
			tags: [Companies]
			summary: Actualizar empresa
			security: [{ sessionAuth: [] }]
			requestBody:
				required: true
				content:
					application/json:
						schema:
							$ref: '#/components/schemas/CompanyInput'
			responses:
				'200':
					description: Empresa actualizada
					content:
						application/json:
							schema:
								$ref: '#/components/schemas/Company'
		delete:
			tags: [Companies]
			summary: Eliminar empresa
			security: [{ sessionAuth: [] }]
			responses:
				'204':
					description: Empresa eliminada

	/products:
		get:
			tags: [Products]
			summary: Listar productos y servicios
			security: [{ sessionAuth: [] }]
			responses:
				'200':
					description: Productos encontrados
					content:
						application/json:
							schema:
								type: array
								items:
									$ref: '#/components/schemas/Product'
		post:
			tags: [Products]
			summary: Crear producto o servicio
			security: [{ sessionAuth: [] }]
			requestBody:
				required: true
				content:
					application/json:
						schema:
							$ref: '#/components/schemas/ProductInput'
			responses:
				'201':
					description: Producto creado
					content:
						application/json:
							schema:
								$ref: '#/components/schemas/Product'
	/products/{id}:
		parameters:
			- $ref: '#/components/parameters/Id'
		get:
			tags: [Products]
			summary: Consultar producto
			security: [{ sessionAuth: [] }]
			responses:
				'200':
					description: Producto encontrado
					content:
						application/json:
							schema:
								$ref: '#/components/schemas/Product'
				'404':
					$ref: '#/components/responses/NotFound'
		put:
			tags: [Products]
			summary: Actualizar producto
			security: [{ sessionAuth: [] }]
			requestBody:
				required: true
				content:
					application/json:
						schema:
							$ref: '#/components/schemas/ProductInput'
			responses:
				'200':
					description: Producto actualizado
					content:
						application/json:
							schema:
								$ref: '#/components/schemas/Product'
		delete:
			tags: [Products]
			summary: Eliminar producto
			security: [{ sessionAuth: [] }]
			responses:
				'204':
					description: Producto eliminado

	/sales:
		get:
			tags: [Sales]
			summary: Listar ventas
			security: [{ sessionAuth: [] }]
			responses:
				'200':
					description: Ventas encontradas
					content:
						application/json:
							schema:
								type: array
								items:
									$ref: '#/components/schemas/Sale'
		post:
			tags: [Sales]
			summary: Registrar venta y calcular totales
			security: [{ sessionAuth: [] }]
			requestBody:
				required: true
				content:
					application/json:
						schema:
							$ref: '#/components/schemas/SaleInput'
			responses:
				'201':
					description: Venta registrada
					content:
						application/json:
							schema:
								$ref: '#/components/schemas/Sale'
				'422':
					$ref: '#/components/responses/ValidationError'
	/sales/{id}:
		parameters:
			- $ref: '#/components/parameters/Id'
		get:
			tags: [Sales]
			summary: Consultar venta con detalle
			security: [{ sessionAuth: [] }]
			responses:
				'200':
					description: Venta encontrada
					content:
						application/json:
							schema:
								$ref: '#/components/schemas/Sale'
				'404':
					$ref: '#/components/responses/NotFound'
		delete:
			tags: [Sales]
			summary: Eliminar venta
			security: [{ sessionAuth: [] }]
			responses:
				'204':
					description: Venta eliminada

	/invoices:
		get:
			tags: [Invoices]
			summary: Listar facturas
			security: [{ sessionAuth: [] }]
			responses:
				'200':
					description: Facturas encontradas
					content:
						application/json:
							schema:
								type: array
								items:
									$ref: '#/components/schemas/Invoice'
	/invoices/{id}:
		parameters:
			- $ref: '#/components/parameters/Id'
		get:
			tags: [Invoices]
			summary: Consultar factura
			security: [{ sessionAuth: [] }]
			responses:
				'200':
					description: Factura encontrada
					content:
						application/json:
							schema:
								$ref: '#/components/schemas/Invoice'
				'404':
					$ref: '#/components/responses/NotFound'
	/invoices/{id}/pdf:
		parameters:
			- $ref: '#/components/parameters/Id'
		get:
			tags: [Invoices]
			summary: Descargar PDF de factura
			security: [{ sessionAuth: [] }]
			responses:
				'200':
					description: Archivo PDF
					content:
						application/pdf:
							schema:
								type: string
								format: binary

	/catalogs/business-types:
		get:
			tags: [Catalogs]
			summary: Listar tipos de empresa
			responses:
				'200':
					description: Catalogo de tipos de empresa
					content:
						application/json:
							schema:
								type: array
								items:
									$ref: '#/components/schemas/CatalogItem'
	/catalogs/tax-regimes:
		get:
			tags: [Catalogs]
			summary: Listar regimenes fiscales
			responses:
				'200':
					description: Catalogo de regimenes fiscales
					content:
						application/json:
							schema:
								type: array
								items:
									$ref: '#/components/schemas/CatalogItem'

components:
	securitySchemes:
		sessionAuth:
			type: apiKey
			in: cookie
			name: PHPSESSID
	parameters:
		Id:
			name: id
			in: path
			required: true
			schema:
				type: integer
				minimum: 1
	responses:
		Unauthorized:
			description: Credenciales invalidas o sesion ausente
			content:
				application/json:
					schema:
						$ref: '#/components/schemas/Error'
		NotFound:
			description: Recurso no encontrado
			content:
				application/json:
					schema:
						$ref: '#/components/schemas/Error'
		ValidationError:
			description: Datos de entrada invalidos
			content:
				application/json:
					schema:
						$ref: '#/components/schemas/Error'
	schemas:
		Error:
			type: object
			required: [message]
			properties:
				message:
					type: string
				errors:
					type: object
					additionalProperties:
						type: array
						items:
							type: string
		LoginRequest:
			type: object
			required: [username, password]
			properties:
				username:
					type: string
					maxLength: 50
				password:
					type: string
					format: password
		AuthResponse:
			type: object
			properties:
				user:
					$ref: '#/components/schemas/User'
				message:
					type: string
		User:
			type: object
			properties:
				id: { type: integer }
				username: { type: string }
				first_name: { type: string }
				last_name: { type: string }
				phone: { type: string, nullable: true }
				email: { type: string, format: email }
				created_at: { type: string, format: date-time }
		ClientInput:
			type: object
			required: [first_name, last_name]
			properties:
				first_name: { type: string, maxLength: 50 }
				last_name: { type: string, maxLength: 50 }
				mother_last_name: { type: string, maxLength: 50, nullable: true }
				phone: { type: string, maxLength: 20, nullable: true }
				email: { type: string, format: email, nullable: true }
				rfc: { type: string, maxLength: 13, nullable: true }
				address: { type: string, nullable: true }
				tax_regime_id: { type: integer, nullable: true }
		Client:
			allOf:
				- $ref: '#/components/schemas/ClientInput'
				- type: object
					properties:
						id: { type: integer }
						created_at: { type: string, format: date-time }
		CompanyInput:
			type: object
			required: [business_name, rfc, fiscal_address]
			properties:
				business_name: { type: string, maxLength: 100 }
				rfc: { type: string, maxLength: 13 }
				fiscal_address: { type: string }
				phone: { type: string, maxLength: 20, nullable: true }
				email: { type: string, format: email, nullable: true }
				legal_representative: { type: string, maxLength: 100, nullable: true }
				business_type_id: { type: integer, nullable: true }
				tax_regime_id: { type: integer, nullable: true }
		Company:
			allOf:
				- $ref: '#/components/schemas/CompanyInput'
				- type: object
					properties:
						id: { type: integer }
						logo_path: { type: string, nullable: true }
						created_at: { type: string, format: date-time }
		ProductInput:
			type: object
			required: [name, type, price]
			properties:
				name: { type: string, maxLength: 100 }
				description: { type: string, nullable: true }
				type: { type: string, enum: [Producto, Servicio] }
				price: { type: number, format: double, minimum: 0 }
		Product:
			allOf:
				- $ref: '#/components/schemas/ProductInput'
				- type: object
					properties:
						id: { type: integer }
						created_at: { type: string, format: date-time }
		SaleInput:
			type: object
			required: [client_id, client_type, sale_date, items]
			properties:
				client_id: { type: integer, minimum: 1 }
				client_type: { type: string, enum: [person, company] }
				sale_date: { type: string, format: date }
				tax_percentage: { type: number, format: double, minimum: 0, default: 16 }
				items:
					type: array
					minItems: 1
					items:
						$ref: '#/components/schemas/SaleDetailInput'
		SaleDetailInput:
			type: object
			required: [product_id, quantity]
			properties:
				product_id: { type: integer, minimum: 1 }
				quantity: { type: integer, minimum: 1 }
				unit_price: { type: number, format: double, minimum: 0 }
				tax_rate: { type: number, format: double, minimum: 0, default: 0 }
		Sale:
			allOf:
				- $ref: '#/components/schemas/SaleInput'
				- type: object
					properties:
						id: { type: integer }
						subtotal: { type: number, format: double }
						tax_amount: { type: number, format: double }
						total: { type: number, format: double }
						created_at: { type: string, format: date-time }
						details:
							type: array
							items:
								$ref: '#/components/schemas/SaleDetail'
		SaleDetail:
			allOf:
				- $ref: '#/components/schemas/SaleDetailInput'
				- type: object
					properties:
						id: { type: integer }
						sale_id: { type: integer }
						subtotal: { type: number, format: double }
		Invoice:
			type: object
			properties:
				id: { type: integer }
				sale_id: { type: integer }
				invoice_number: { type: string, maxLength: 20 }
				invoice_date: { type: string, format: date }
				pdf_path: { type: string, nullable: true }
				created_at: { type: string, format: date-time }
				sale:
					$ref: '#/components/schemas/Sale'
		CatalogItem:
			type: object
			required: [id, name]
			properties:
				id: { type: integer }
				name: { type: string }
